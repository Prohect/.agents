{{#if (or (contains available_tools 'grep') (contains available_tools 'find_path'))}}- {{#if (contains available_tools 'grep')}}`grep`{{/if}}{{#if (and (contains available_tools 'grep') (contains available_tools 'find_path'))}} / {{/if}}{{#if (contains available_tools 'find_path')}}`find_path`{{/if}}
